# ==============================================================================
# AEGIS Voice-Sentinel — Deployment Configuration
# Copy to `.env` and adjust per environment. NEVER hardcode values in source.
# ==============================================================================

# --- Environment ---
AEGIS_ENV=dev                       # dev | prod (prod enforces strict CORS)
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_RELOAD=0

# --- CORS: REQUIRED in prod. Comma-separated dashboard origins ---
# AEGIS_CORS_ORIGINS=https://aegis.mha.gov.in,https://operator.i4c.gov.in

# --- Audio pipeline ---
AEGIS_SAMPLE_RATE=16000
AEGIS_WINDOW_DURATION=2.0
AEGIS_HOP_DURATION=0.5
AEGIS_HIGHPASS_HZ=80
AEGIS_LOWPASS_HZ=7500
# Silence/VAD gates — tune per telephony profile or mic hardware:
AEGIS_SILENCE_RMS=0.008
AEGIS_SILENCE_SPEECH_RATIO=0.12
AEGIS_SILENCE_SPEECH_RATIO_HARD=0.04
AEGIS_SILENCE_PEAK=0.012

# --- Consensus engine (multi-model decision policy) ---
AEGIS_CONSENSUS_ENABLED=1
AEGIS_CONSENSUS_DISAGREEMENT=30     # |engine A - engine B| beyond this -> INCONCLUSIVE
AEGIS_CONSENSUS_FAKE=70             # fused score >= -> SYNTHETIC
AEGIS_CONSENSUS_REAL=35             # fused score <= -> AUTHENTIC
AEGIS_CONSENSUS_W_AASIST=0.3        # engine fusion weights (normalized internally;
AEGIS_CONSENSUS_W_RAWNET=0.7        #  tune on a held-out dev set per deployment)

# --- Evidence persistence ---
AEGIS_DB_BACKEND=sqlite             # sqlite | postgres | memory (dev only)
AEGIS_DB_SQLITE_PATH=data/aegis_evidence.db

# --- Security (REQUIRED for AEGIS_ENV=prod) ---
AEGIS_AUTH_ENABLED=0                # 1 requires clients to send X-API-Key
AEGIS_API_KEY=
AEGIS_RATE_LIMIT_ENABLED=1
AEGIS_RATE_OTP_PER_MIN=10
AEGIS_RATE_ANALYZE_PER_MIN=20
AEGIS_RATE_CHALLENGE_PER_MIN=30

# --- WebSocket hardening ---
AEGIS_WS_MAX_FRAME_BYTES=65536
AEGIS_WS_MAX_SESSIONS=64

# --- Training ---
# python -m backend.training.train --data-dir large_benchmark_data,scam_call_data --epochs 30

# --- Risk thresholds (0-100) ---
AEGIS_RISK_CRITICAL=75
AEGIS_RISK_SUSPICIOUS=40
AEGIS_RISK_ANOMALY_FLAG=50
AEGIS_CHALLENGE_SMOOTHED=75
AEGIS_CHALLENGE_INSTANT=88
AEGIS_CHALLENGE_INSTANT_FLOOR=50
AEGIS_DOSSIER_DEEPFAKE=60

# --- Prevention / OTP ---
AEGIS_CHALLENGE_TTL=180
AEGIS_MAX_OTP_ATTEMPTS=3
AEGIS_OTP_LENGTH=6
AEGIS_AUDIT_LOG_SIZE=100

# --- Model ---
AEGIS_DEVICE=auto                   # auto | cpu | cuda | mps
AEGIS_DEFAULT_MODEL=aasist
AEGIS_ANALYSIS_WINDOW_S=2.0
AEGIS_RISK_FLOOR=4.0
AEGIS_RISK_CEILING=99.4

# --- Forensic dossier (agency-level defaults; per-case overrides via API) ---
AEGIS_AGENCY=Indian Cyber Crime Coordination Centre (I4C) / State Cyber Cell
AEGIS_POLICE_STATION=Cyber Crime Police Station, Special Cell
AEGIS_OFFICER=Inspector (Cyber Forensic Division)

# --- STT / Language intelligence ---
AEGIS_STT_LANGUAGE=en-IN            # Indian English; supports hi-IN, ta-IN, etc.
AEGIS_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=                     # optional: enables AI semantic analysis
